<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>FacebookOneClient</AssemblyName>
    <Title>Facebook One Client</Title>
    <Product>Facebook One Client</Product>
    <Description>Facebook One Client — Cross-platform Desktop Application built with Avalonia UI and Native AOT.</Description>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IsPackable>false</IsPackable>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(PublishSingleFile)' == 'true'">embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Facebook.Net.Contracts\Facebook.Net.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Facebook.Net\Facebook.Net.csproj" />
    <ProjectReference Include="..\..\src\Facebook.Net.Storage\Facebook.Net.Storage.csproj" />
    <ProjectReference Include="..\..\browser\Facebook.Net.Browser\Facebook.Net.Browser.csproj" />
    <ProjectReference Include="..\..\browser\Facebook.Net.Browser.Windows\Facebook.Net.Browser.Windows.csproj" />
    <ProjectReference Include="..\..\browser\Facebook.Net.Browser.MacOS\Facebook.Net.Browser.MacOS.csproj" />
    <ProjectReference Include="..\Facebook.Net.UI.Core\Facebook.Net.UI.Core.csproj" />
    <ProjectReference Include="..\Facebook.Net.UI.Components\Facebook.Net.UI.Components.csproj" />
    <ProjectReference Include="..\Facebook.Net.UI.ViewModels\Facebook.Net.UI.ViewModels.csproj" />
    <ProjectReference Include="..\..\mcp\Facebook.Net.Mcp\Facebook.Net.Mcp.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="RemovePdbAndXmlFromSingleFilePublish"
          AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Extension)' == '.pdb' or '%(Extension)' == '.xml'" />
    </ItemGroup>
  </Target>

</Project>
