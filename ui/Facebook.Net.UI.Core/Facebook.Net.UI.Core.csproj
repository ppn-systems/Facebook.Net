<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>Facebook.Net.UI.Core - Theme, i18n, Audit Log DB &amp; Universal Session Importer</Title>
    <Description>Shared UI infrastructure for Facebook.Net: Dark/Light Theme Engine, Bilingual i18n (vi-VN &amp; en-US), Dedicated Audit Log SQLite Database, and Universal Cookie/J2Team Session Importer.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Facebook.Net.Contracts\Facebook.Net.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Locales\*.json" LogicalName="Assets.Locales.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
