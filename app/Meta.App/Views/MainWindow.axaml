<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Meta.UI.ViewModels.Shell"
        x:Class="Meta.App.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Width="1380"
        Height="850"
        MinWidth="1180"
        MinHeight="720"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Icon="avares://FacebookOneClient/Assets/app.ico">
    <Grid x:Name="ShellRootGrid" ColumnDefinitions="Auto,*,Auto">
        <Border x:Name="SidebarContainer" Grid.Column="0" />
        <Border x:Name="WorkspaceContainer" Grid.Column="1" Padding="22,12,22,10">
            <Grid RowDefinitions="*,Auto">
                <TransitioningContentControl x:Name="PageNavigationHost"
                                             Grid.Row="0"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch" />
                <Border x:Name="TopBusyContainer"
                        Grid.Row="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        Margin="0,-8,0,0"
                        ZIndex="15" />
                <Border x:Name="TopContextContainer"
                        Grid.Row="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        ZIndex="10" />
                <Border x:Name="FooterContainer" Grid.Row="1" />
            </Grid>
        </Border>
        <Border x:Name="AiAssistantContainer" Grid.Column="2" />
    </Grid>
</Window>
